# Copy to .env (never commit .env). Used by: npm run watch:env / npm run db:init:env  (needs Node 20.6+)
INTELLIDOC_DB=Server=HOST,1433;Database=idoc_dev;User Id=USER;Password=PASSWORD;Encrypt=true;TrustServerCertificate=true
WATCH_DIR=C:\IntelliDoc\watch
# POLL_SECONDS=5
# STABLE_SECONDS=10
# RETRY_SECONDS=60
# PDF_ENGINE=auto
# CHECK_POSTCODES=0
# LOG_FILE=C:\IntelliDoc\watch\watcher.log
# XML_FIRST=1
# PDF_WAIT_MINUTES=30
# PDF_REMINDER_MINUTES=30
# ALERT_TO=ops@example.com
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=alerts@example.com
# SMTP_PASS=
# SMTP_FROM=alerts@example.com
