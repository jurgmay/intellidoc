{
  "name": "intellidoc-ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dry-run": "tsx src/cli.ts",
    "test:db": "vitest run test/db",
    "watch": "tsx src/watch.ts",
    "db:init": "tsx src/initDevDb.ts",
    "watch:env": "tsx --env-file=.env src/watch.ts",
    "db:init:env": "tsx --env-file=.env src/initDevDb.ts",
    "db:reset": "tsx --env-file=.env src/initDevDb.ts --reset",
    "import:ref": "tsx src/import/cli.ts",
    "import:ref:env": "tsx --env-file=.env src/import/cli.ts",
    "stock:codes": "tsx src/import/assignCodes.ts",
    "runsheets": "tsx src/runsheet/cli.ts",
    "runsheets:env": "tsx --env-file=.env src/runsheet/cli.ts",
    "stock:codes:env": "tsx --env-file=.env src/import/assignCodes.ts"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "bwip-js": "^4.11.4",
    "mssql": "^12.8.0",
    "nodemailer": "^10.6.1",
    "pdf-lib": "^1.17.1",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
