# Copy to .env.test (never commit .env.test). Used only by: npm run test:db
# The database tests DROP and recreate the idoc schema here. The database name must contain test, scratch or tmp.
INTELLIDOC_TEST_DB=Server=HOST,1433;Database=intellidoc-test;User Id=USER;Password=PASSWORD;Encrypt=true;TrustServerCertificate=true
