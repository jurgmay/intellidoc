{
  "name": "intellidoc-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:db": "node --env-file=.env.test node_modules/vitest/vitest.mjs run test/db",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "dev:stub": "tsx src/stubServer.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.0",
    "jose": "^6.2.18",
    "mssql": "^12.8.0",
    "pdf-lib": "^1.17.1",
    "read-excel-file": "^5.8.8",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
