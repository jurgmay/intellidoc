# Copy to .env (never commit .env)
INTELLIDOC_DB=Server=HOST,1433;Database=intellidoc-scratch;User Id=USER;Password=PASSWORD;Encrypt=true;TrustServerCertificate=true
# API_PORT=3001
# API_HOST=127.0.0.1
# Making print files from the Jobs page uses the same folders as the watcher:
# WATCH_DIR=C:\idoc-import
# COMPOSE_OUT_DIR=C:\idoc-print
# MRDF_OUT_DIR=C:\idoc-mrdf
# GS_PATH=gswin64c
# The run sheet e-mail (Settings > PDF and alerts) uses the same mail server as the watcher:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=idoc@example.com
# SMTP_PASS=
# SMTP_FROM=IntelliDoc <idoc@example.com>
