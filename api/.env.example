# Copy to .env (never commit .env)
INTELLIDOC_DB=Server=HOST,1433;Database=intellidoc-scratch;User Id=USER;Password=PASSWORD;Encrypt=true;TrustServerCertificate=true
# Encrypts the network password saved in Settings > Network (any passphrase of 16+ characters). Keep it safe: without it a saved password cannot be read.
# INTELLIDOC_SECRET_KEY=
# API_PORT=3001
# API_HOST=127.0.0.1
# Making print files from the Jobs page uses the same folders as the watcher:
# WATCH_DIR=C:\idoc-import
# COMPOSE_OUT_DIR=C:\idoc-print
# MRDF_OUT_DIR=C:\idoc-mrdf
# GS_PATH=gswin64c
# The run sheet e-mail (Settings > PDF and alerts) uses the same mail server as the watcher:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=idoc@example.com
# SMTP_PASS=
# SMTP_FROM=IntelliDoc <idoc@example.com>

# Sign-in with Microsoft Entra ID (see docs/auth.md). The API will not start without these.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# The address people type, with no trailing slash. Entra is told to return to <this>/api/auth/callback.
# AUTH_PUBLIC_URL=https://intellidoc.example.com
# Signs the session cookie: 32+ characters, e.g. openssl rand -base64 48
# SESSION_SECRET=
# SESSION_HOURS=8
# Development only, on 127.0.0.1: no sign-in, everyone is an administrator.
# AUTH_MODE=off
